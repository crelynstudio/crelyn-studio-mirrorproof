{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Folder selection and explicit developer links. File analysis is read-only Rust code.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-save",
    "notification:default",
    { "identifier": "opener:allow-open-url", "allow": [
      { "url": "https://crelynstudio.com" },
      { "url": "mailto:info@crelynstudio.com" },
      { "url": "https://github.com/crelynstudio" },
      { "url": "https://www.behance.net/crelynstudio" },
      { "url": "https://www.instagram.com/crelynstudio/" },
      { "url": "https://x.com/crelynstudio" },
      { "url": "https://www.threads.com/@crelynstudio" }
    ] }
  ]
}
