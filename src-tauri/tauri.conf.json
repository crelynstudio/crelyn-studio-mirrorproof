{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MirrorProof",
  "version": "0.1.0",
  "identifier": "com.crelynstudio.mirrorproof",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "removeUnusedCommands": true,
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "MirrorProof",
      "width": 1160,
      "height": 800,
      "minWidth": 760,
      "minHeight": 640,
      "center": true,
      "decorations": false,
      "backgroundColor": "#D8D9DC"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Crelyn Studio",
    "homepage": "https://crelynstudio.com",
    "shortDescription": "File integrity and backup verification",
    "longDescription": "Compare folders and verify backup contents with SHA-256. Local, read-only file analysis with reports, manifests and scan history.",
    "copyright": "Copyright © 2026 Crelyn Studio",
    "license": "MIT",
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../THIRD-PARTY-NOTICES.md": "ThirdPartyNotices.md",
      "../docs/ThirdPartyLicenses.html": "ThirdPartyLicenses.html"
    },
    "category": "Utility",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
